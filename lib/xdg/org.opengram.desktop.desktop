[Desktop Entry]
Name=opengram
Comment=Free and minimalistic Telegram client for desktop
TryExec=Telegram
Exec=Telegram -- %U
Icon=org.opengram.desktop
Terminal=false
StartupWMClass=opengram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;x-scheme-handler/ton;
Keywords=tg;chat;im;messaging;messenger;sms;opengram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=Telegram -quit
Name=Quit opengram
Icon=application-exit
